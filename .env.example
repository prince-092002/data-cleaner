# Production settings: names and safe placeholders only. Set real values in the Vercel project, never commit them.
# On Vercel the app refuses to start unless DC_STORAGE_BACKEND=blob, DC_JOB_RUNNER=queue and DATABASE_URL are set.

# Pooled Postgres URL (Neon). Empty means SQLite, local only.
DATABASE_URL=
# local (default) or blob
DC_STORAGE_BACKEND=blob
# inprocess (default) or queue
DC_JOB_RUNNER=queue
# Default 50; production 4 (Vercel body limit is 4.5 MB)
DC_MAX_UPLOAD_MB=4
# Random string. Vercel Cron sends it as a Bearer token to /api/cron/cleanup
CRON_SECRET=
# Random string. Salts the stored hash of client IPs
DC_IP_HASH_SALT=
# Global uploads per day. Default 5 with DC_JOB_RUNNER=queue, none otherwise
DC_DAILY_UPLOAD_CAP=
# Global jobs per day. Default 200
DC_DAILY_JOB_CAP=
# Jobs per address per day. Default 10, never above the global cap
DC_DAILY_IP_CAP=
# Uploads per address per day. Default 2, never above the global cap. IPv6 is grouped by /64
DC_DAILY_IP_UPLOAD_CAP=
# Stored-bytes guard in MB. Default 800
DC_STORAGE_LIMIT_MB=
